# Copy to .env and fill in
OPENROUTER_API_KEY=sk-or-...
# Required to run Alpha on a public server (protects chat + command running)
ACCESS_KEY=choose-a-long-random-password
DEFAULT_MODEL=openai/gpt-4o-mini
# Used automatically when credits run out or a model is rate-limited (comma separated)
FREE_MODELS=openrouter/free,meta-llama/llama-3.3-70b-instruct:free,deepseek/deepseek-chat-v3-0324:free
# Optional last-resort fallback: a model running on your own server (https://ollama.com)
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2
# PORT=3000
